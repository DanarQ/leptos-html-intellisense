{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "leptos-html-injection",
  "scopeName": "inline.leptos.html",
  "injectionSelector": "L:source.rust -comment -string",
  "patterns": [
    {
      "name": "meta.embedded.leptos.html",
      "begin": "(view!)\\s*(\\{|\\()",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.macro.rust"
        },
        "2": {
          "name": "punctuation.definition.block.rust"
        }
      },
      "end": "(\\}|\\))",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.block.rust"
        }
      },
      "patterns": [
        {
          "include": "text.html.basic"
        }
      ]
    }
  ]
}
